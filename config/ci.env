# GitHub Actions settings. The SQL Server here is a throwaway container that only exists
# for the length of one CI run, so this password protects nothing and is safe to commit.
EDP_SQL_SERVER=localhost,1433
EDP_SQL_TRUSTED=false
EDP_SQL_USER=sa
EDP_SQL_PASSWORD=CiOnly!Throwaway_2026
EDP_SQL_TRUST_CERT=true
EDP_SOURCE_DB=SourceEMR
EDP_WAREHOUSE_DB=EDW
