# Copy to config/dev.env (git-ignored) and adjust for your workstation.
# Default: SQL Server Express on this machine with Windows authentication, so no password.
EDP_SQL_SERVER=localhost\SQLEXPRESS
EDP_SQL_TRUSTED=true
EDP_SQL_TRUST_CERT=true
EDP_SOURCE_DB=SourceEMR
EDP_WAREHOUSE_DB=EDW

# SQL authentication instead:
# EDP_SQL_TRUSTED=false
# EDP_SQL_USER=your_login
# EDP_SQL_PASSWORD=set_this_in_the_shell_not_in_a_file
